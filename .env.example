# Medimall Review App Environment Configuration

# Shared Staff Password (FR-1)
STAFF_PASSWORD=replace-with-a-strong-staff-password

# Session Security Secret (Used for HMAC signed httpOnly cookie)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Supabase PostgreSQL Configuration (FR-Tech Stack & Data Model)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Default App Language (en or ml)
NEXT_PUBLIC_DEFAULT_LANG=en
